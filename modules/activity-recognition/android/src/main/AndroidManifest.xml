<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
  <uses-permission android:name="com.google.android.gms.permission.ACTIVITY_RECOGNITION" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <application>
    <receiver
      android:name="expo.modules.activityrecognition.ActivityReceiver"
      android:exported="false" />
    <receiver
      android:name="expo.modules.activityrecognition.LocationReceiver"
      android:exported="false" />
    <!-- riaccensione automatica all'avvio del telefono e dopo un aggiornamento dell'app -->
    <receiver
      android:name="expo.modules.activityrecognition.BootReceiver"
      android:enabled="true"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
        <action android:name="android.intent.action.QUICKBOOT_POWERON" />
        <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
      </intent-filter>
    </receiver>
    <service
      android:name="expo.modules.activityrecognition.BootTaskService"
      android:exported="false" />
  </application>
</manifest>
