{
  "name": "parcheggio",
  "version": "0.3.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "test:engine": "node --test \"engine/__tests__/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "replay": "node tools/replay.ts",
    "sweep": "node tools/sweep.ts",
    "build:android": "eas build --platform android --profile preview --non-interactive --no-wait",
    "build:ios": "eas build --platform ios --profile preview",
    "update": "eas update --channel preview --non-interactive --message"
  },
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "expo": "~54.0.0",
    "expo-application": "~7.0.0",
    "expo-battery": "~10.0.0",
    "expo-build-properties": "~1.0.0",
    "expo-clipboard": "~8.0.0",
    "expo-constants": "~18.0.0",
    "expo-dev-client": "~6.0.0",
    "expo-device": "~8.0.0",
    "expo-file-system": "~19.0.0",
    "expo-haptics": "~15.0.0",
    "expo-intent-launcher": "~13.0.0",
    "expo-location": "~19.0.0",
    "expo-notifications": "~0.32.0",
    "expo-sensors": "~15.0.0",
    "expo-sharing": "~14.0.0",
    "expo-sqlite": "~16.0.0",
    "expo-status-bar": "~3.0.0",
    "expo-task-manager": "~14.0.0",
    "expo-updates": "~29.0.0",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "react-native-maps": "1.20.1",
    "react-native-safe-area-context": "~5.6.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  }
}
