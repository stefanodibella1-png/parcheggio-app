rules_version = '2';
// PARCHEGGIO / ParkingCT — regole del server (senza account utente).
// Ogni collezione accetta solo documenti ben formati; nessun dato personale.
service cloud.firestore {
  match /databases/{database}/documents {

    // Control center segreto (7 tocchi sul logo + password admin, cambiabile dall'app).
    // admin/key = { s: impronta della password, v: id della cassaforte } — nessuno può leggerlo.
    // Chi conosce la password ricava s, legge gate/{s} e ottiene v; tutti i dati riservati
    // stanno in vault/{v}. Le scritture pubbliche dell'admin (codici, pubblicità) sono valide
    // solo se nello stesso invio viene scritto vault/{v}/tokens/w con l'ora del server.
    function adminKey() {
      return get(/databases/$(database)/documents/admin/key).data;
    }
    function adminBatch() {
      return exists(/databases/$(database)/documents/admin/key)
        && getAfter(/databases/$(database)/documents/vault/$(adminKey().v)/tokens/w).data.t == request.time;
    }

    match /admin/key {
      allow read, delete: if false;
      // prima volta: si sceglie la password
      allow create: if request.resource.data.keys().hasOnly(['s', 'v', 'prev'])
        && request.resource.data.s is string && request.resource.data.s.size() == 64
        && request.resource.data.v is string && request.resource.data.v.size() >= 20;
      // cambio password: serve quella attuale
      allow update: if request.resource.data.keys().hasOnly(['s', 'v', 'prev'])
        && request.resource.data.prev == resource.data.s
        && request.resource.data.v == resource.data.v
        && request.resource.data.s is string && request.resource.data.s.size() == 64;
    }

    match /gate/{s} {
      allow get: if exists(/databases/$(database)/documents/admin/key) && s == adminKey().s;
      allow create: if s == getAfter(/databases/$(database)/documents/admin/key).data.s
        && request.resource.data.keys().hasOnly(['v'])
        && request.resource.data.v == getAfter(/databases/$(database)/documents/admin/key).data.v;
      allow list, update, delete: if false;
    }

    match /vault/{v}/{document=**} {
      allow read, write: if exists(/databases/$(database)/documents/admin/key) && v == adminKey().v;
    }

    // diagnostica: errori dell'app (solo scrittura; li legge il server con GitHub Actions)
    match /crashes/{id} {
      allow read: if false;
      allow create, update: if request.resource.data.keys().hasOnly(['t', 'kind', 'app', 'build', 'update', 'os', 'msg', 'stack', 'extra'])
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 3000
        && request.resource.data.stack is string && request.resource.data.stack.size() <= 3000;
    }

    // posti che si liberano (community)
    match /spots/{id} {
      allow read: if true;
      allow delete: if true;
      allow create, update: if
        request.resource.data.keys().hasOnly(['id', 'kind', 'latitude', 'longitude', 'geohash6', 'address',
          'quality', 'confidence', 'freeAt', 'createdAt', 'expiresAt', 'deviceId'])
        && request.resource.data.kind in ['FREED', 'SOON']
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number
        && request.resource.data.geohash6 is string
        && request.resource.data.geohash6.size() == 6
        && request.resource.data.expiresAt is number
        && request.resource.data.expiresAt < request.resource.data.createdAt + 3600000;
    }

    // conferme automatiche: un utente ha davvero parcheggiato su un posto ricevuto
    match /validations/{id} {
      allow read: if true;
      allow create, update: if
        request.resource.data.keys().hasOnly(['spotId', 'latitude', 'longitude', 'geohash6', 't', 'deviceId'])
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number
        && request.resource.data.geohash6 is string
        && request.resource.data.geohash6.size() == 6;
    }

    // ParkingCT: configurazione del lancio (scritta solo dal server)
    match /config/{id} {
      allow read: if true;
      allow write: if false;
    }

    // ParkingCT: telefoni per zona (cella geohash5, ~5 km). I numeri li calcola il server per il control center.
    match /devices/{id} {
      allow read: if false;
      allow create, update: if
        request.resource.data.keys().hasOnly(['zone', 't', 'founder', 'first', 'tier', 'v'])
        && request.resource.data.zone is string
        && request.resource.data.zone.size() == 5
        && request.resource.data.t is number
        && request.resource.data.founder is bool;
    }

    // ParkingCT: codici dei sostenitori fondatori (id = impronta SHA-256 del codice).
    // Si legge solo il singolo codice (impossibile elencarli); si usa una volta sola.
    // Livelli: base, oro, platino (con codici regalo), regalo.
    match /codes/{hash} {
      allow get: if true;
      allow list, delete: if false;
      allow create: if adminBatch();
      allow update: if adminBatch() || (
        // prima attivazione
        resource.data.usedBy == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt', 'start'])
        && request.resource.data.usedBy is string
        && request.resource.data.usedAt is number) || (
        // stesso codice su un nuovo telefono / app reinstallata: al massimo 5 spostamenti
        resource.data.usedBy != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt', 'moves'])
        && request.resource.data.usedBy is string
        && request.resource.data.usedAt is number
        && request.resource.data.moves == resource.data.get('moves', 0) + 1
        && request.resource.data.moves <= 5);
    }

    // ParkingCT: pubblicità (scritte dal control center, lette dall'app)
    match /ads/{id} {
      allow read: if true;
      allow write: if adminBatch();
    }

    // ParkingCT: visualizzazioni e tocchi delle pubblicità (anonimi)
    match /adEvents/{id} {
      allow read, delete: if false;
      allow create: if
        request.resource.data.keys().hasOnly(['adId', 'kind', 't', 'zone'])
        && request.resource.data.adId is string
        && request.resource.data.kind in ['view', 'click']
        && request.resource.data.t is number;
    }

    // ParkingCT: amici invitati (id = codice invito di chi invita). Ogni nuovo telefono aggiunge 1.
    match /invites/{code} {
      allow get: if true;
      allow list, delete: if false;
      allow create: if
        request.resource.data.keys().hasOnly(['n', 't'])
        && request.resource.data.n == 1
        && request.resource.data.t is number
        && code.size() <= 12;
      allow update: if (
        request.resource.data.keys().hasOnly(['n', 't'])
        && request.resource.data.n == resource.data.n + 1
        && request.resource.data.t is number);
    }

    // ParkingCT: muro dei fondatori. Id = impronta del codice usato (o "inv-" + codice amico per chi
    // ha invitato abbastanza amici). Solo chi ha usato quel codice può scrivere; il livello è quello
    // del codice, non lo sceglie l'app. Il nome compare solo se l'utente lo vuole (visible).
    function wallUserOk(id) {
      return request.resource.data.keys().hasOnly(['name', 'visible', 'tier', 't', 'by', 'mod', 'modName', 'edits', 'honor', 'inv'])
        && request.resource.data.get('edits', 0) is int
        // titolo di Fondatore onorario solo con abbastanza amici portati
        && (request.resource.data.get('honor', false) == false
          || (request.resource.data.inv is string && request.resource.data.inv.size() <= 12
            && get(/databases/$(database)/documents/invites/$(request.resource.data.inv)).data.n
               >= get(/databases/$(database)/documents/config/public).data.inviteFreeAt))
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && request.resource.data.visible is bool
        && request.resource.data.t is number
        && request.resource.data.by is string
        && (
          (exists(/databases/$(database)/documents/codes/$(id))
            && get(/databases/$(database)/documents/codes/$(id)).data.usedBy == request.resource.data.by
            && request.resource.data.tier == get(/databases/$(database)/documents/codes/$(id)).data.get('tier', 'base'))
          ||
          (id.matches('inv-[A-Z0-9]{4,12}')
            && request.resource.data.tier == 'amici'
            && get(/databases/$(database)/documents/invites/$(id.replace('^inv-', ''))).data.n
               >= get(/databases/$(database)/documents/config/public).data.inviteFreeAt)
        );
    }

    // mod / modName = moderazione dal control center ('ok' = approvato quel nome, 'hidden' = nascosto e bloccato)
    match /wall/{id} {
      allow read: if true;
      allow delete: if false;
      // nome: si scrive una volta e si corregge una sola volta (edits = nomi scritti, massimo 2);
      // tornare anonimi (nome vuoto) è sempre permesso
      allow create: if wallUserOk(id)
        && request.resource.data.get('mod', '') == '' && request.resource.data.get('modName', '') == ''
        && request.resource.data.get('edits', 0) == (request.resource.data.name == '' ? 0 : 1);
      allow update: if adminBatch() || (
        wallUserOk(id)
        && resource.data.get('mod', '') != 'hidden'
        && request.resource.data.get('mod', '') == resource.data.get('mod', '')
        && request.resource.data.get('modName', '') == resource.data.get('modName', '')
        && (
          (request.resource.data.name == '' || request.resource.data.name == resource.data.name)
            && request.resource.data.get('edits', 0) == resource.data.get('edits', 0)
          ||
          request.resource.data.get('edits', 0) == resource.data.get('edits', 0) + 1
            && request.resource.data.get('edits', 0) <= 2
        ));
    }

    // ParkingCT: pagamenti Stripe. purchases = registro privato (solo server);
    // pickup/{ref} = il codice per il telefono che ha pagato (ref casuale di 32 caratteri, noto solo a lui)
    match /purchases/{id} {
      allow read, write: if false;
    }
    match /pickup/{ref} {
      allow get: if ref.size() == 32;
      allow list, write: if false;
    }

    // ParkingCT: parcheggi anonimi per costruire la mappa dei posti veri (solo scrittura)
    match /parkings/{id} {
      allow read: if false;
      allow create: if
        request.resource.data.keys().hasOnly(['latitude', 'longitude', 'geohash7', 'parkedT', 'durationS',
          'outcome', 'exitedOnFoot', 'quality', 'atFuel', 'gpsLost', 'deviceId'])
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number
        && request.resource.data.geohash7 is string
        && request.resource.data.geohash7.size() == 7;
    }
  }
}
